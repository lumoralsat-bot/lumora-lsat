# ── Browser-visible (VITE_ prefix = bundled into the public site; only put public values here) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PRICE_MONTHLY=
VITE_STRIPE_PRICE_YEARLY=
# Local `vite dev` only (compiled out of production builds). In production use ANTHROPIC_API_KEY.
VITE_ANTHROPIC_API_KEY=

# ── Server-only (set in Vercel; NEVER add a VITE_ prefix) ──
ANTHROPIC_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PROMO_CODES=
